{
  "description": "Copyable SwitchSignal MCP JSON-RPC request examples. Send these to /api/mcp with Authorization: Bearer <SWITCHSIGNAL_MCP_KEY>.",
  "endpoint": "https://switchsignal.grindworks.ai/api/mcp",
  "requests": [
    {
      "name": "list_allowed_tools",
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/list",
        "params": {}
      }
    },
    {
      "name": "audit_categories",
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "tools/call",
        "params": {
          "name": "switchsignal.audit_categories",
          "arguments": {}
        }
      }
    },
    {
      "name": "capture_plan",
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "tools/call",
        "params": {
          "name": "switchsignal.capture_plan",
          "arguments": {
            "categoryId": "forms-survey-free-response-caps",
            "priority": "high_or_medium",
            "limit": 3
          }
        }
      }
    },
    {
      "name": "tool_contracts",
      "request": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "resources/read",
        "params": {
          "uri": "switchsignal://tool-contracts"
        }
      }
    },
    {
      "name": "client_report",
      "request": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "tools/call",
        "params": {
          "name": "switchsignal.client_report",
          "arguments": {
            "clientId": "<owned-client-id>"
          }
        }
      },
      "requires": {
        "scope": "intelligence:read",
        "entitlement": "mcp.read_call",
        "notes": "Returns a user-scoped client report with readiness score, source boundary, top signal quality, campaign-pack value brief, and outcome feedback path."
      }
    },
    {
      "name": "create_signal_from_category",
      "request": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "tools/call",
        "params": {
          "name": "switchsignal.create_signal_from_category",
          "arguments": {
            "categoryId": "email-marketing-free-tier",
            "competitorName": "MailerLite"
          }
        }
      },
      "requires": {
        "scope": "signals:write",
        "entitlement": "mcp.signal_write",
        "notes": "Creates a bounded signal only inside the authenticated user's workspace and returns quality/scoring metadata."
      }
    },
    {
      "name": "generate_campaign_pack",
      "request": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "tools/call",
        "params": {
          "name": "switchsignal.generate_campaign_pack",
          "arguments": {
            "signalId": "<owned-signal-id>"
          }
        }
      },
      "requires": {
        "scope": "campaign-packs:write",
        "entitlement": "mcp.campaign_pack_write",
        "notes": "Returns the hosted campaign pack valueBrief with evidence, source boundary, proof table, client decision, execution checklist, quality score, and cannot-claim guardrails."
      }
    }
  ],
  "safety": [
    "Never commit a real MCP key.",
    "Start with read-only keys for discovery.",
    "Use write scopes only after confirming user approval and usage budget.",
    "Bulk outreach, cold email, cold DM, and automated social posting are not exposed by this public bridge."
  ]
}
